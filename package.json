{
  "name": "yuanji-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name yuanji-hub --branch main",
    "db:create": "wrangler d1 create software-finder-db",
    "db:migrate:local": "wrangler d1 migrations apply software-finder-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply software-finder-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
